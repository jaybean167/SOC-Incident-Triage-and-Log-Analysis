#!/bin/bash
# Scenario 2: Generate SHA-256 hashes of files in target directory

TARGET_DIR="${1:-/tmp}"

echo "=========================================="
echo " Generating SHA-256 Hashes for: $TARGET_DIR "
echo "=========================================="

if [ -d "$TARGET_DIR" ]; then
    find "$TARGET_DIR" -maxdepth 2 -type f -exec sha256sum {} + 2>/dev/null
else
    echo "Directory $TARGET_DIR does not exist."
fi
